# Copy to .env (git-ignored). services/system2/main.py loads it; variables already set in the shell win.
GATEWAY_URL=http://localhost:8080
GATEWAY_KEY=                      # key of the `router-p2` client created in ../llm-gateway (scripts/new_key.py)
LLM_MODEL=smart_router
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=              # Langfuse Cloud > project settings > API keys (pk-lf-...)
LANGFUSE_SECRET_KEY=              # (sk-lf-...)
